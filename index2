<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Casa Velha - Terminal de Check-in</title>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      body * { visibility: hidden; }
      #printable-boletim, #printable-boletim * { visibility: visible; }
      #printable-boletim { position: absolute; left: 0; top: 0; width: 100%; }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzZitsCHoHUdgDwb2g8OrJEUm6tkXob-XhiywGuRt2ZAIPH9pwTWVvXGc2hQzA4psfbTg/exec";

    const TIPOS_ALOJAMENTO = [
      "Quarto Duplo com Vista Mar",
      "Quarto Triplo",
      "Estúdio",
      "Apartamento Dúplex"
    ];

    const MODOS_PAGAMENTO = [
      "Numerário",
      "Booking",
      "MB",
      "Outro"
    ];

    const PLATAFORMAS_RESERVA = [
      "sem reserva",
      "Booking",
      "AirBnb",
      "Site Próprio",
      "Outro"
    ];

    // Mapeamento de Países com Código ICAO de 3 letras para AIMA
    const PAISES_ICAO = [
      { nome: "Portugal", code: "PRT" },
      { nome: "Alemanha", code: "DEU" },
      { nome: "Espanha", code: "ESP" },
      { nome: "França", code: "FRA" },
      { nome: "Reino Unido", code: "GBR" },
      { nome: "Itália", code: "ITA" },
      { nome: "Países Baixos (Holanda)", code: "NLD" },
      { nome: "Bélgica", code: "BEL" },
      { nome: "Brasil", code: "BRA" },
      { nome: "Estados Unidos", code: "USA" },
      { nome: "Canadá", code: "CAN" },
      { nome: "Suíça", code: "CHE" },
      { nome: "Irlanda", code: "IRL" },
      { nome: "Áustria", code: "AUT" },
      { nome: "Polónia", code: "POL" },
      { nome: "Suécia", code: "SWE" },
      { nome: "Noruega", code: "NOR" },
      { nome: "Dinamarca", code: "DNK" },
      { nome: "Finlândia", code: "FIN" },
      { nome: "Afeganistão", code: "AFG" },
      { nome: "África do Sul", code: "ZAF" },
      { nome: "Albânia", code: "ALB" },
      { nome: "Andorra", code: "AND" },
      { nome: "Angola", code: "AGO" },
      { nome: "Argentina", code: "ARG" },
      { nome: "Austrália", code: "AUS" },
      { nome: "Cabo Verde", code: "CPV" },
      { nome: "China", code: "CHN" },
      { nome: "Colômbia", code: "COL" },
      { nome: "Guiné-Bissau", code: "GNB" },
      { nome: "Índia", code: "IND" },
      { nome: "Japão", code: "JPN" },
      { nome: "Marrocos", code: "MAR" },
      { nome: "México", code: "MEX" },
      { nome: "Moçambique", code: "MOZ" },
      { nome: "Paquistão", code: "PAK" },
      { nome: "Roménia", code: "ROU" },
      { nome: "Rússia", code: "RUS" },
      { nome: "São Tomé e Príncipe", code: "STP" },
      { nome: "Ucrânia", code: "UKR" },
      { nome: "Venezuela", code: "VEN" }
    ];

    const ANO_ATUAL = new Date().getFullYear();
    const ANOS_LISTA = Array.from({ length: ANO_ATUAL - 1920 + 1 }, (_, i) => ANO_ATUAL - i);
    const MESES_LISTA = [
      { num: '01', nome: 'Janeiro' }, { num: '02', nome: 'Fevereiro' }, { num: '03', nome: 'Março' },
      { num: '04', nome: 'Abril' }, { num: '05', nome: 'Maio' }, { num: '06', nome: 'Junho' },
      { num: '07', nome: 'Julho' }, { num: '08', nome: 'Agosto' }, { num: '09', nome: 'Setembro' },
      { num: '10', nome: 'Outubro' }, { num: '11', nome: 'Novembro' }, { num: '12', nome: 'Dezembro' }
    ];

    // Sanitização de Carateres segundo regras AIMA (Alfabetico Nome: Só Maiúsculas e carateres permitidos)
    const sanitizarTextoAIMA = (txt) => {
      if (!txt) return '';
      return String(txt)
        .toUpperCase()
        .replace(/[^A-ZÇÃÁÀÉÊÍÕÔÓÚ'\-\s]/g, '')
        .trimStart();
    };

    function CheckInAIMA() {
      const [loading, setLoading] = useState(false);
      
      const [searchQuery, setSearchQuery] = useState('');
      const [searchResults, setSearchResults] = useState([]);
      const [searching, setSearching] = useState(false);
      const [editingRegisto, setEditingRegisto] = useState(null);
      const [novaDataSaida, setNovaDataSaida] = useState('');
      const [updating, setUpdating] = useState(false);

      const [idadeCalculada, setIdadeCalculada] = useState(null);
      const [ultimoSucesso, setUltimoSucesso] = useState(null);
      
      const [showSobreModal, setShowSobreModal] = useState(false);
      const [showBoletimForm, setShowBoletimForm] = useState(true);

      const [alertaRecorrente, setAlertaRecorrente] = useState(null);
      const [verificandoDoc, setVerificandoDoc] = useState(false);

      const [funcionarios, setFuncionarios] = useState([]);
      const [selectedFuncObj, setSelectedFuncObj] = useState({ id: '', nome: '' });

      const [nasceAno, setNasceAno] = useState('');
      const [nasceMes, setNasceMes] = useState('01');
      const [nasceDia, setNasceDia] = useState('01');

      const todayStr = new Date().toISOString().slice(0, 10);

      const [novoBoletim, setNovoBoletim] = useState({
        apelido: '',
        nome: '',
        dataNascimento: '',
        nacionalidade: 'PRT',
        localNascimento: '',
        docTipo: 'B', // B - BI/CC, P - Passaporte, O - Outro
        docNumero: '',
        docPais: 'PRT',
        paisResidencia: 'PRT',
        localResidencia: '',
        dataEntrada: todayStr,
        dataSaida: '',
        tipoAlojamento: 'Quarto Duplo com Vista Mar',
        numeroUnidade: '1',
        eMenor: 'Não',
        titularDoc: 'Próprio',
        qualidadeAcompanhante: 'N/A',
        valorReserva: '',
        taxaTuristica: '0.00',
        modoPagamento: 'Numerário',
        numeroReserva: '',
        plataformaReserva: 'sem reserva'
      });

      const [numeroNoites, setNumeroNoites] = useState(0);

      const calcularDiferencaNoites = (d1Str, d2Str) => {
        if (!d1Str || !d2Str) return 0;
        const dIn = new Date(d1Str);
        const dOut = new Date(d2Str);
        const diffTime = dOut - dIn;
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        return diffDays > 0 ? diffDays : 0;
      };

      useEffect(() => {
        setNumeroNoites(calcularDiferencaNoites(novoBoletim.dataEntrada, novoBoletim.dataSaida));
      }, [novoBoletim.dataEntrada, novoBoletim.dataSaida]);

      const noitesTributaveis = Math.min(numeroNoites, 7);
      const taxaSugeridaMatosinhos = (idadeCalculada !== null && idadeCalculada < 16) 
        ? 0 
        : (noitesTributaveis * 2);

      const valorTaxaNum = Number(novoBoletim.taxaTuristica || 0);
      const menorComTaxaIncorreta = idadeCalculada !== null && idadeCalculada < 16 && valorTaxaNum > 0;
      const taxaExcedeLimiteMaximo = valorTaxaNum > 14;
      const taxaComAvisoErro = menorComTaxaIncorreta || taxaExcedeLimiteMaximo;

      const formatarDataLimpa = (dStr) => {
        if (!dStr) return '';
        const str = String(dStr).trim();
        if (str.length >= 10 && str.match(/^\d{4}-\d{2}-\d{2}/)) {
          return str.slice(0, 10);
        }
        const d = new Date(str);
        if (!isNaN(d.getTime())) {
          return d.toISOString().slice(0, 10);
        }
        return str.slice(0, 10);
      };

      const handleNumeroReservaChange = (val) => {
        const numLimpo = val;
        setNovoBoletim(prev => {
          if (!numLimpo.trim()) {
            return { ...prev, numeroReserva: numLimpo, plataformaReserva: 'sem reserva' };
          } else {
            const platAtual = prev.plataformaReserva === 'sem reserva' ? 'Booking' : prev.plataformaReserva;
            return { ...prev, numeroReserva: numLimpo, plataformaReserva: platAtual };
          }
        });
      };

      useEffect(() => {
        fetch(GOOGLE_SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: "GET_EMPLOYEES" })
        })
        .then(res => res.json())
        .then(res => {
          if (res.status === "success" && res.data && res.data.length > 0) {
            setFuncionarios(res.data);
            setSelectedFuncObj(res.data[0]);
          }
        })
        .catch(() => {});
      }, []);

      const handleSelectNascimento = (ano, mes, dia) => {
        setNasceAno(ano);
        setNasceMes(mes);
        setNasceDia(dia);

        if (ano && mes && dia) {
          const formattedDate = `${ano}-${mes}-${String(dia).padStart(2, '0')}`;
          setNovoBoletim(prev => ({ ...prev, dataNascimento: formattedDate }));
        }
      };

      useEffect(() => {
        if (!novoBoletim.dataNascimento) {
          setIdadeCalculada(null);
          setNovoBoletim(prev => ({ ...prev, eMenor: 'Não', titularDoc: 'Próprio', qualidadeAcompanhante: 'N/A' }));
          return;
        }

        const nascimento = new Date(novoBoletim.dataNascimento);
        const hoje = new Date(novoBoletim.dataEntrada || todayStr);
        
        let idade = hoje.getFullYear() - nascimento.getFullYear();
        const m = hoje.getMonth() - nascimento.getMonth();
        if (m < 0 || (m === 0 && hoje.getDate() < nascimento.getDate())) {
          idade--;
        }

        if (!isNaN(idade)) {
          setIdadeCalculada(idade);
          const valorSugerido = idade < 16 ? '0.00' : (Math.min(numeroNoites, 7) * 2).toFixed(2);
          setNovoBoletim(prev => ({ 
            ...prev, 
            taxaTuristica: valorSugerido,
            eMenor: idade < 18 ? 'Sim' : 'Não',
            titularDoc: idade < 18 ? (prev.titularDoc === 'Próprio' ? 'Documento do Acompanhante' : prev.titularDoc) : 'Próprio',
            qualidadeAcompanhante: idade < 18 ? (prev.qualidadeAcompanhante === 'N/A' ? 'Pai, Mãe' : prev.qualidadeAcompanhante) : 'N/A'
          }));
        }
      }, [novoBoletim.dataNascimento, novoBoletim.dataEntrada, numeroNoites]);

      const gerarIDBoletim = () => {
        const d = new Date();
        const datePart = d.getFullYear() + String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0');
        const randomPart = Math.floor(1000 + Math.random() * 9000);
        return `CV-${datePart}-${randomPart}`;
      };

      const handleSubmit = async (e) => {
        e.preventDefault();

        if (!novoBoletim.apelido.trim()) {
          alert('Por favor introduza o Apelido do hóspede.');
          return;
        }

        if (!novoBoletim.dataNascimento) {
          alert('Por favor selecione a Data de Nascimento.');
          return;
        }

        if (!novoBoletim.dataSaida || novoBoletim.dataSaida <= novoBoletim.dataEntrada) {
          alert('A data de check-out prevista deve ser posterior à data de check-in.');
          return;
        }

        setLoading(true);

        const idBoletim = gerarIDBoletim();
        const funcionarioString = selectedFuncObj.id 
          ? `[${selectedFuncObj.id}] ${selectedFuncObj.nome}` 
          : selectedFuncObj.nome;

        // Nome Completo Unificado para a visualização interna do impresso
        const nomeCompleto = `${novoBoletim.apelido} ${novoBoletim.nome}`.trim();

        const payload = { 
          ...novoBoletim, 
          nomeCompleto,
          idBoletim, 
          funcionarioRececao: funcionarioString,
          funcionarioId: selectedFuncObj.id || '',
          funcionarioNome: selectedFuncObj.nome || funcionarioString,
          noitesCalculadas: numeroNoites
        };

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 3500);

        try {
          await fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: controller.signal
          });
        } catch (error) {
        } finally {
          clearTimeout(timeoutId);
          setLoading(false);
          setUltimoSucesso(payload);

          setNovoBoletim({
            apelido: '',
            nome: '',
            dataNascimento: '',
            nacionalidade: 'PRT',
            localNascimento: '',
            docTipo: 'B',
            docNumero: '',
            docPais: 'PRT',
            paisResidencia: 'PRT',
            localResidencia: '',
            dataEntrada: todayStr,
            dataSaida: '',
            tipoAlojamento: novoBoletim.tipoAlojamento,
            numeroUnidade: novoBoletim.numeroUnidade,
            eMenor: 'Não',
            titularDoc: 'Próprio',
            qualidadeAcompanhante: 'N/A',
            valorReserva: '',
            taxaTuristica: '0.00',
            modoPagamento: 'Numerário',
            numeroReserva: '',
            plataformaReserva: 'sem reserva'
          });
          setNasceAno('');
          setIdadeCalculada(null);
          setAlertaRecorrente(null);
        }
      };

      const handleSearch = async (e) => {
        e.preventDefault();
        if (!searchQuery.trim()) return;

        setSearching(true);
        setEditingRegisto(null);

        try {
          const response = await fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ action: "SEARCH_GUEST", query: searchQuery })
          });
          const result = await response.json();

          if (result.status === "success") {
            setSearchResults(result.data || []);

            if ((result.data || []).length === 0) {
              alert('Nenhum registo encontrado com o termo pesquisado.');
            }
          }
        } catch (error) {
          alert('Erro ao realizar a pesquisa.');
        } finally {
          setSearching(false);
        }
      };

      return (
        <div className="min-h-screen pb-12">
          {/* CABEÇALHO PRINCIPAL */}
          <header className="bg-slate-900 text-white p-4 shadow-md">
            <div className="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
              <div>
                <div className="flex items-center gap-2">
                  <h1 className="text-xl font-bold">🏠 Casa Velha</h1>
                  <button 
                    onClick={() => setShowSobreModal(true)}
                    className="bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-[11px] font-semibold px-2.5 py-1 rounded transition flex items-center gap-1"
                  >
                    ℹ️ Sobre
                  </button>
                </div>
                <p className="text-xs text-slate-400">Terminal de Check-in (RNAL 166503/AL)</p>
              </div>

              {/* LOGIN DO FUNCIONÁRIO */}
              <div className="bg-slate-800 p-2.5 rounded-lg border border-slate-700 flex items-center gap-2 text-xs w-full md:w-auto">
                <span className="text-slate-400 font-semibold hidden sm:inline">👤 Receção:</span>
                <div className="flex-1 md:flex-initial">
                  {funcionarios.length > 0 ? (
                    <select 
                      value={selectedFuncObj.id || selectedFuncObj.nome}
                      onChange={e => {
                        const val = e.target.value;
                        const found = funcionarios.find(f => f.id === val || f.nome === val);
                        setSelectedFuncObj(found || { id: '', nome: val });
                      }}
                      className="w-full md:w-60 bg-slate-900 text-white border border-slate-600 rounded px-2 py-1.5 font-bold outline-none focus:ring-1 focus:ring-blue-500 text-xs"
                    >
                      {funcionarios.map(f => (
                        <option key={f.id || f.nome} value={f.id || f.nome}>{f.nome}</option>
                      ))}
                    </select>
                  ) : (
                    <input 
                      type="text" 
                      placeholder="Nome do Funcionário" 
                      value={selectedFuncObj.nome}
                      onChange={e => setSelectedFuncObj({ id: 'FUNC', nome: e.target.value })}
                      className="w-full md:w-60 bg-slate-900 text-white border border-slate-600 rounded px-2 py-1.5 font-bold text-xs"
                    />
                  )}
                </div>
              </div>
            </div>
          </header>

          <main className="max-w-4xl mx-auto p-4 mt-4 space-y-6">

            {/* PAINEL: NOVO FORMULÁRIO DE CHECK-IN COM ESTRUTURA AIMA */}
            <div className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
              <div 
                onClick={() => setShowBoletimForm(!showBoletimForm)}
                className="p-5 bg-slate-50 border-b border-slate-200 flex justify-between items-center cursor-pointer select-none hover:bg-slate-100 transition"
              >
                <div>
                  <h2 className="text-lg font-bold text-slate-800 flex items-center gap-2">
                    📋 Novo Boletim de Alojamento (Formato AIMA / ICAO)
                  </h2>
                  <p className="text-xs text-slate-500">Registo de hóspede com validação rigorosa de campos legais.</p>
                </div>
                <button type="button" className="text-slate-600 hover:text-slate-900 text-lg font-bold p-1">
                  {showBoletimForm ? '▲' : '▼'}
                </button>
              </div>

              {showBoletimForm && (
                <div className="p-6 space-y-4">
                  <form onSubmit={handleSubmit} className="space-y-4 text-sm">
                    
                    {/* 1. Documento de Identificação */}
                    <div className="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-3">
                      <h3 className="font-bold text-slate-700 text-xs uppercase tracking-wider">
                        1. Documento de Identificação (Regra AIMA)
                      </h3>

                      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Tipo de Documento *</label>
                          <select 
                            value={novoBoletim.docTipo} 
                            onChange={e => setNovoBoletim({...novoBoletim, docTipo: e.target.value})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white font-medium text-xs"
                          >
                            <option value="B">B - Bilhete de Identidade / CC</option>
                            <option value="P">P - Passaporte</option>
                            <option value="O">O - Outro Documento</option>
                          </select>
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Número do Documento *</label>
                          <input 
                            type="text" 
                            placeholder="Sem espaços" 
                            value={novoBoletim.docNumero} 
                            onChange={e => setNovoBoletim({...novoBoletim, docNumero: e.target.value.replace(/\s+/g, '').toUpperCase()})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none font-mono font-bold text-slate-900 text-xs" 
                            maxLength={16}
                            required 
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">País Emissor (Código ICAO) *</label>
                          <select 
                            value={novoBoletim.docPais} 
                            onChange={e => setNovoBoletim({...novoBoletim, docPais: e.target.value})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white font-medium text-xs"
                          >
                            {PAISES_ICAO.map(p => <option key={p.code} value={p.code}>{p.nome} ({p.code})</option>)}
                          </select>
                        </div>
                      </div>
                    </div>

                    {/* 2. Nomes e Identificação do Hóspede */}
                    <div className="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-3">
                      <h3 className="font-bold text-slate-700 text-xs uppercase tracking-wider">2. Nomes e Identificação Pessoal</h3>
                      
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Apelido (Último Nome / Família) *</label>
                          <input 
                            type="text" 
                            placeholder="Ex: SILVA (Obrigatório)" 
                            value={novoBoletim.apelido} 
                            onChange={e => setNovoBoletim({...novoBoletim, apelido: sanitizarTextoAIMA(e.target.value)})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none font-bold text-slate-900 text-xs uppercase" 
                            maxLength={40}
                            required 
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Outros Nomes (Opcional se for nome único)</label>
                          <input 
                            type="text" 
                            placeholder="Ex: JOÃO MANUEL" 
                            value={novoBoletim.nome} 
                            onChange={e => setNovoBoletim({...novoBoletim, nome: sanitizarTextoAIMA(e.target.value)})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none font-medium text-xs uppercase" 
                            maxLength={40}
                          />
                        </div>
                      </div>

                      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                        {/* SELEÇÃO DE NASCIMENTO */}
                        <div className="bg-white p-3 rounded border border-slate-200">
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Data Nascimento *</label>
                          <div className="grid grid-cols-3 gap-1">
                            <select 
                              value={nasceAno} 
                              onChange={e => handleSelectNascimento(e.target.value, nasceMes, nasceDia)}
                              className="border p-1 rounded text-xs font-bold"
                              required
                            >
                              <option value="">Ano</option>
                              {ANOS_LISTA.map(a => <option key={a} value={a}>{a}</option>)}
                            </select>
                            <select 
                              value={nasceMes} 
                              onChange={e => handleSelectNascimento(nasceAno, e.target.value, nasceDia)}
                              className="border p-1 rounded text-xs"
                            >
                              {MESES_LISTA.map(m => <option key={m.num} value={m.num}>{m.num}</option>)}
                            </select>
                            <select 
                              value={nasceDia} 
                              onChange={e => handleSelectNascimento(nasceAno, nasceMes, e.target.value)}
                              className="border p-1 rounded text-xs"
                            >
                              {Array.from({ length: 31 }, (_, i) => String(i + 1).padStart(2, '0')).map(d => (
                                <option key={d} value={d}>{d}</option>
                              ))}
                            </select>
                          </div>
                        </div>

                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Nacionalidade (Código ICAO) *</label>
                          <select 
                            value={novoBoletim.nacionalidade} 
                            onChange={e => setNovoBoletim({...novoBoletim, nacionalidade: e.target.value})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white font-medium text-xs"
                          >
                            {PAISES_ICAO.map(p => <option key={p.code} value={p.code}>{p.nome} ({p.code})</option>)}
                          </select>
                        </div>

                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Local de Nascimento (Opcional)</label>
                          <input 
                            type="text" 
                            placeholder="Cidade / Naturalidade" 
                            value={novoBoletim.localNascimento} 
                            onChange={e => setNovoBoletim({...novoBoletim, localNascimento: e.target.value})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none font-medium text-xs" 
                            maxLength={40}
                          />
                        </div>
                      </div>

                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">País de Residência (Código ICAO) *</label>
                          <select 
                            value={novoBoletim.paisResidencia} 
                            onChange={e => setNovoBoletim({...novoBoletim, paisResidencia: e.target.value})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white font-medium text-xs"
                          >
                            {PAISES_ICAO.map(p => <option key={p.code} value={p.code}>{p.nome} ({p.code})</option>)}
                          </select>
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Local de Residência (Opcional)</label>
                          <input 
                            type="text" 
                            placeholder="Cidade de residência habitual" 
                            value={novoBoletim.localResidencia} 
                            onChange={e => setNovoBoletim({...novoBoletim, localResidencia: e.target.value})} 
                            className="w-full border border-slate-300 p-2.5 rounded focus:ring-2 focus:ring-blue-500 outline-none font-medium text-xs" 
                            maxLength={30}
                          />
                        </div>
                      </div>
                    </div>

                    {/* 3. Dados da Reserva */}
                    <div className="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-3">
                      <h3 className="font-bold text-slate-700 text-xs uppercase tracking-wider">3. Dados da Reserva & Alojamento</h3>
                      <div className="grid grid-cols-1 sm:grid-cols-4 gap-3">
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Tipo de Alojamento *</label>
                          <select 
                            value={novoBoletim.tipoAlojamento} 
                            onChange={e => setNovoBoletim({...novoBoletim, tipoAlojamento: e.target.value})} 
                            className="w-full border border-slate-300 p-2 rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white font-medium text-xs"
                          >
                            {TIPOS_ALOJAMENTO.map(t => <option key={t} value={t}>{t}</option>)}
                          </select>
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Unidade *</label>
                          <input 
                            type="text" 
                            value={novoBoletim.numeroUnidade} 
                            onChange={e => setNovoBoletim({...novoBoletim, numeroUnidade: e.target.value})} 
                            className="w-full border border-slate-300 p-2 rounded text-xs font-bold" 
                            required 
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">N.º Reserva</label>
                          <input 
                            type="text" 
                            placeholder="Opcional" 
                            value={novoBoletim.numeroReserva} 
                            onChange={e => handleNumeroReservaChange(e.target.value)} 
                            className="w-full border border-slate-300 p-2 rounded text-xs" 
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Plataforma *</label>
                          <select 
                            value={novoBoletim.plataformaReserva} 
                            onChange={e => setNovoBoletim({...novoBoletim, plataformaReserva: e.target.value})} 
                            disabled={!novoBoletim.numeroReserva.trim()}
                            className="w-full border border-slate-300 p-2 rounded bg-white text-xs disabled:bg-slate-100"
                          >
                            {PLATAFORMAS_RESERVA.map(p => <option key={p} value={p}>{p}</option>)}
                          </select>
                        </div>
                      </div>
                    </div>

                    {/* 4. Estadia & Valores Financeiros */}
                    <div className="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-3">
                      <h3 className="font-bold text-slate-700 text-xs uppercase tracking-wider">4. Período da Estadia, Pagamentos</h3>
                      
                      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Data de Entrada (Check-in) *</label>
                          <input 
                            type="date" 
                            value={novoBoletim.dataEntrada} 
                            onChange={e => setNovoBoletim({...novoBoletim, dataEntrada: e.target.value})} 
                            className="w-full border border-slate-300 p-2 rounded text-xs font-bold" 
                            required 
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-700 mb-1">Data Prevista Saída (Check-out) *</label>
                          <input 
                            type="date" 
                            value={novoBoletim.dataSaida} 
                            onChange={e => setNovoBoletim({...novoBoletim, dataSaida: e.target.value})} 
                            className="w-full border border-slate-300 p-2 rounded text-xs font-bold" 
                            required 
                          />
                        </div>
                        <div className="bg-white border border-slate-300 p-2 rounded text-center">
                          <span className="text-[10px] block text-slate-500 font-semibold uppercase">Duração</span>
                          <span className="text-xs font-bold text-blue-900">{numeroNoites} {numeroNoites === 1 ? 'Noite' : 'Noites'}</span>
                        </div>
                      </div>

                      {/* TAXA TURÍSTICA */}
                      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                        <div>
                          <label className="block text-xs font-semibold text-emerald-800 mb-1">Valor Reserva (€)</label>
                          <input 
                            type="number" 
                            step="0.01" 
                            value={novoBoletim.valorReserva} 
                            onChange={e => setNovoBoletim({...novoBoletim, valorReserva: e.target.value})} 
                            className="w-full border border-emerald-300 p-2 rounded bg-emerald-50/50 font-bold text-xs" 
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-emerald-800 mb-1">Taxa Turística (€) *</label>
                          <input 
                            type="number" 
                            step="0.01" 
                            value={novoBoletim.taxaTuristica} 
                            onChange={e => setNovoBoletim({...novoBoletim, taxaTuristica: e.target.value})} 
                            className="w-full border border-emerald-300 p-2 rounded bg-emerald-50/50 font-bold text-xs" 
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-emerald-800 mb-1">Modo Pagamento *</label>
                          <select 
                            value={novoBoletim.modoPagamento} 
                            onChange={e => setNovoBoletim({...novoBoletim, modoPagamento: e.target.value})} 
                            className="w-full border border-emerald-300 p-2 rounded bg-emerald-50/50 font-bold text-xs"
                          >
                            {MODOS_PAGAMENTO.map(m => <option key={m} value={m}>{m}</option>)}
                          </select>
                        </div>
                      </div>
                    </div>

                    <button 
                      type="submit" 
                      disabled={loading}
                      className="w-full bg-blue-700 text-white font-bold py-3.5 rounded-lg hover:bg-blue-800 transition shadow text-base disabled:bg-slate-400"
                    >
                      {loading ? 'A Guardar...' : '💾 Confirmar Check-in'}
                    </button>
                  </form>
                </div>
              )}
            </div>

          </main>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<CheckInAIMA />);
  </script>
</body>
</html>
